{
  "name": "motionvault-remotion",
  "version": "0.1.0",
  "private": true,
  "description": "MotionVault — Vietnamese Remotion infographic gallery and editable studio",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "remotion render src/remotion/index.ts",
    "compositions": "remotion compositions src/remotion/index.ts",
    "typecheck": "tsc --noEmit",
    "check:source": "node scripts/check-source.mjs"
  },
  "dependencies": {
    "@remotion/player": "^4.0.0",
    "@remotion/three": "^4.0.0",
    "@react-three/fiber": "^8.17.10",
    "three": "^0.160.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
